# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Confirm exact model IDs, availability, pricing and context window in the Nebius Token Factory model catalog
# (run: python -m app.check_nebius to list the Nemotron IDs your account can use):
NEMOTRON_NANO_MODEL=
NEMOTRON_SUPER_MODEL=
NEMOTRON_ULTRA_MODEL=
# true = use the clearly labeled seeded patch if the model API is unavailable
DEMO_MODE=false
# optional, for the measured cost estimate (USD per 1M tokens, from the model catalog)
MODEL_PRICE_INPUT_PER_1M_USD=
MODEL_PRICE_OUTPUT_PER_1M_USD=
# Optional advisory intent check by Nemotron Nano on live demo runs: off | annotate | escalate
NANO_INTENT_CHECK=off
